[Unit]
Description=Tangping ETF freshness guard (only the dividend repository)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
StateDirectory=tangping-market-watchdog
WorkingDirectory=/opt/tangping-dividend
EnvironmentFile=/etc/tangping-market-watchdog.env
Environment=DIVIDEND_WATCHDOG_STATE=/var/lib/tangping-market-watchdog/state.json
ExecStart=/usr/bin/node /opt/tangping-dividend/scripts/market-watchdog.mjs --dispatch --monitor
TimeoutStartSec=22min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=256M
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tangping-market-watchdog
